{
  "expo": {
    "name": "ZO-ZAR",
    "slug": "zo-zar",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/zo-zar-icon-flat.png",
    "scheme": "zo-zar",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/zo-zar-icon-flat.png"
    },
    "android": {
      "package": "com.zozar.app",
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_NOTIFICATION_POLICY",
        "android.permission.MODIFY_AUDIO_SETTINGS"
        ,"android.permission.USE_FULL_SCREEN_INTENT"
        ,"android.permission.FOREGROUND_SERVICE"
        ,"android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        ,"android.permission.RECEIVE_BOOT_COMPLETED"
        ,"android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1C1C19",
        "foregroundImage": "./assets/images/zo-zar-mark-flat.png",
        "monochromeImage": "./assets/images/zo-zar-mark-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/zo-zar-favicon-flat.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F0E4",
          "image": "./assets/images/zo-zar-splash-light.png",
          "imageWidth": 132,
          "dark": {
            "backgroundColor": "#1C1C19",
            "image": "./assets/images/zo-zar-splash-dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/zo-zar-mark-monochrome.png",
          "color": "#E7BB72",
          "defaultChannel": "zo-zar-wake-alarms-v3-zozar",
          "sounds": [
            "./assets/audio/bright_rise.wav",
            "./assets/audio/steady_pulse.wav",
            "./assets/audio/summit_siren.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow ZO-ZAR to record short voice messages.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f838dbf1-98cc-4318-a755-4cf43c87e6c9"
      }
    },
    "owner": "abuzarhaideri"
  }
}
