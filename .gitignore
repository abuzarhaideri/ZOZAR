.agents/skills/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env
.env.*
!.env.example

# server credentials
**/*service-account*.json
**/*firebase-adminsdk*.json
# A real service-account key was committed once as firebase-key.json, which matched
# neither pattern above. Match on what the file IS, not what it happens to be named.
firebase-key.json
**/*firebase*key*.json
**/*-key.json

# generated release artifacts
*.apk
*.aab

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Backend projects are independent npm installs
server/node_modules/
infra/node_modules/

# Design reference scraped from other products. Local only: it is 18MB of third-party
# artwork, it never ships in the app, and it must not enter this repo history.
design/
.playwright-mcp/

# The user's design review bundle: reference only, not shipped.
design-exports/

# iCloud/Finder conflict copies ("file 2.ts"). They are byte-identical duplicates and
# once slipped into a commit via `git add -A`.
* 2.ts
* 2.tsx
* 2.json
* 2.kt

# Zoho Catalyst
# The AppSail bundle is a build artefact: 64 MB of generated code and node_modules,
# rebuilt by scripts/build-catalyst.sh. catalyst.json is config and IS committed.
catalyst/api/
# Per-developer CLI state: which project and environment this machine has selected.
.catalystrc
