# Local development only. In AWS these come from SSM Parameter Store.

# Aiven connection string. Aiven always requires TLS, so production uses sslmode=require.
DATABASE_URL=postgres://avnadmin:password@pg-zozar.aivencloud.com:12345/defaultdb?sslmode=require

# Aiven's project CA certificate, base64 encoded. Aiven signs its database certificates
# with a per-project CA that Node's trust store does not know, so without this the peer
# cannot be verified. Required in production; the server refuses to start without it.
#   base64 -i ca.pem | tr -d '\n'
DATABASE_CA_CERT=

# Pointing at a throwaway local Postgres instead? Containers serve no certificate, so
# turn TLS off rather than failing the handshake:
#   DATABASE_URL=postgres://zozar:zozar@localhost:5432/zozar_test?sslmode=disable

# Signing key for access tokens. Must be at least 32 bytes.
#   openssl rand -base64 48
JWT_SECRET=

# S3 bucket for voice notes and profile photos.
S3_BUCKET=zozar-media-dev
AWS_REGION=ap-southeast-1

# API Gateway WebSocket callback endpoint, injected by CDK at deploy time.
WS_ENDPOINT=

# Firebase service account JSON, single line. FCM delivery only.
FIREBASE_SERVICE_ACCOUNT=
