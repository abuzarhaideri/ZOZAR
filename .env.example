# ZO-ZAR API, from the CDK stack output `ApiUrl`.
# Without this the app runs on in-memory local state: screens work, nothing persists.
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# WebSocket endpoint for live chat, from the stack output `WebSocketUrl`. Optional —
# without it messages still arrive on fetch, just not instantly.
EXPO_PUBLIC_WS_URL=wss://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

EXPO_PUBLIC_ANDROID_PACKAGE=com.zozar.app

# ---------------------------------------------------------------------------
# One-time migration only, for scripts/audit-appwrite.mjs. Not used by the app.
# A read-scoped key from the old Appwrite console; delete it once the data has moved.
# ---------------------------------------------------------------------------
# APPWRITE_PROJECT_ID=
# APPWRITE_API_KEY=
