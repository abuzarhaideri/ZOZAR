# ZO-ZAR API. Set this and the app uses the AWS backend; leave it empty and it falls back
# to Appwrite, or to in-memory local state if that is unconfigured too.
# Taken from the CDK stack output `ApiUrl`.
EXPO_PUBLIC_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com

# WebSocket endpoint for live chat, from the stack output `WebSocketUrl`. Optional:
# without it messages still arrive on fetch, just not instantly.
EXPO_PUBLIC_WS_URL=wss://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod

EXPO_PUBLIC_ANDROID_PACKAGE=com.zozar.app

# ---------------------------------------------------------------------------
# Legacy Appwrite configuration. Retained only until the data migration runs;
# EXPO_PUBLIC_API_URL takes precedence over all of it. Never put an API key or a
# Firebase service account here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=zozar
EXPO_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=zozar-private
EXPO_PUBLIC_APPWRITE_ACTIONS_FUNCTION_ID=zozar-actions
