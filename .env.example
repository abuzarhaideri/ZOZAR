# Public Appwrite resource identifiers. Never put an API key or Firebase service account here.
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_DATABASE_ID=zozar
EXPO_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=zozar-private
EXPO_PUBLIC_APPWRITE_ACTIONS_FUNCTION_ID=zozar-actions
EXPO_PUBLIC_ANDROID_PACKAGE=com.zozar.app

# Table IDs default to these values when omitted.
EXPO_PUBLIC_APPWRITE_PROFILES_TABLE_ID=profiles
EXPO_PUBLIC_APPWRITE_COMMITMENTS_TABLE_ID=commitments
EXPO_PUBLIC_APPWRITE_WAKE_PLANS_TABLE_ID=wake_plans
EXPO_PUBLIC_APPWRITE_WAKE_OCCURRENCES_TABLE_ID=wake_occurrences
EXPO_PUBLIC_APPWRITE_CONNECTIONS_TABLE_ID=connections
EXPO_PUBLIC_APPWRITE_CHAT_THREADS_TABLE_ID=chat_threads
EXPO_PUBLIC_APPWRITE_MESSAGES_TABLE_ID=messages
EXPO_PUBLIC_APPWRITE_DEVICE_TOKENS_TABLE_ID=device_tokens
EXPO_PUBLIC_APPWRITE_NOTIFICATION_JOBS_TABLE_ID=notification_jobs
